  "_comment": "Every figure the narration, captions and slides quote. {{name}} in storyboard.json and slides/*.html is replaced by the value here. The render checks every entry in _sources before anything is recorded and stops on a mismatch: the recorded live runs (frontend/public/samples, the Oct 24 takes the backend's fixtures replay, and the simulation and Monte Carlo files computed from them), the live evaluation (docs/eval/2026-10-24-live-eval-run4/eval.rescored.csv, run 4 on the final pipeline, the Nemotron 3 Ultra arm the architecture slide routes to, scored with the final checks), or 'screen' for a figure the app computes live during the capture and no recorded file holds (the Monte Carlo MTBF, a panel setting): those must be quoted by a waitForText in storyboard.json, so the render stops if the screen shows anything else. Figures the screen also shows (the plan's verdicts and repairs, the failure's progress, the replan's delay, the Monte Carlo misses, the what-if and its gain) are quoted by a waitForText too, so they are checked against both the recorded run and the capture. TBD = not known yet: repo_url hides the close slide's repository line until it is set.",
  "_sources": {
    "landing_makespan_h": "samples/landing_pad.plan.json schedule.makespan_h",
    "landing_horizon_h": "samples/landing_pad.plan.json requirements.horizon_h",
    "landing_repair_rounds": "samples/landing_pad.plan.json repairs",
    "plan_core1_need_wh": "samples/landing_pad.plan.json steps.2.failure.details.0 |re:at least ([\\d,]+) Wh",
    "plan_core1_need_wh_words": "samples/landing_pad.plan.json steps.2.failure.details.0 |re:at least ([\\d,]+) Wh |num |words",
    "printer_battery_wh": "samples/landing_pad.plan.json steps.2.failure.details.0 |re:carries ([\\d,]+) Wh",
    "printer_battery_wh_words": "samples/landing_pad.plan.json steps.2.failure.details.0 |re:carries ([\\d,]+) Wh |num |words",
    "plan_core2_need_wh": "samples/landing_pad.plan.json steps.4.failure.details.0 |re:at least ([\\d,]+) Wh",
    "plan_core2_over_wh": "samples/landing_pad.plan.json steps.4.failure.details.0 |re:at least ([\\d,]+) Wh.*carries ([\\d,]+) Wh |num |diff",
    "plan_crest_m2_0": "samples/landing_pad.plan.json steps.3.payload.diff.changed.2.before",
    "plan_crest_m2_1": "samples/landing_pad.plan.json steps.3.payload.diff.changed.2.after",
    "plan_crest_m2_2": "samples/landing_pad.plan.json steps.5.payload.diff.changed.1.after",
    "replan_robot": "samples/landing_pad.sim.json events.0.robot",
    "replan_robot_no": "samples/landing_pad.sim.json events.0.robot |re:(\\d+)$ |num",
    "replan_fail_h": "samples/landing_pad.sim.json events.0.t_h",
    "replan_progress": "samples/landing_pad.sim.json events.0.detail |re:\\((\\d+%) done\\)",
    "replan_tasks": "samples/landing_pad.sim.json replans.0.remaining_tasks |len",
    "replan_before_h": "samples/landing_pad.sim.json replans.0.before.makespan_h",
    "replan_after_h": "samples/landing_pad.sim.json finished_at_h",
    "replan_delta_h": "samples/landing_pad.sim.json replans.0 |pick:after.schedule.makespan_h,before.makespan_h |diff",
    "mc_runs": "samples/landing_pad.mc.json runs",
    "mc_within_pct": "samples/landing_pad.mc.json within_horizon_rate |pct",
    "mc_misses": "samples/landing_pad.mc.json |misses",
    "mc_spof_misses": "samples/landing_pad.mc.json |nobackup",
    "mc_spof_count": "samples/landing_pad.mc.json single_points_of_failure |len",
    "mc_mtbf_h": "screen",
    "whatif_pct": "samples/landing_pad.whatif.mc.json within_horizon_rate |pct",
    "whatif_gain_pts": "samples/landing_pad.whatif.mc.json within_horizon_rate |minus:samples/landing_pad.mc.json within_horizon_rate |pts",
    "impossible_deadline_h": "samples/front_loaded.plan.json requirements.horizon_h",
    "impossible_needed_h": "samples/front_loaded.plan.json suggestions.0.horizon_h",
    "impossible_repair_rounds": "samples/front_loaded.plan.json repairs",
    "impossible_scope_drift": "samples/front_loaded.plan.json steps.4.payload.diff.scope_drift_pct |abs |pctn",
    "eval_briefs": "csv docs/eval/2026-10-24-live-eval-run4/eval.rescored.csv condition=ultra/loop_on |distinct:brief",
    "eval_kinds": "csv docs/eval/2026-10-24-live-eval-run4/eval.rescored.csv condition=ultra/loop_on |distinct:kind",
    "eval_runs": "csv docs/eval/2026-10-24-live-eval-run4/eval.rescored.csv condition=ultra/loop_on |len",
    "eval_verified_pct": "csv docs/eval/2026-10-24-live-eval-run4/eval.rescored.csv condition=ultra/loop_on |share:success=True |pct",
    "eval_in_scope_pct": "csv docs/eval/2026-10-24-live-eval-run4/eval.rescored.csv condition=ultra/loop_on |share:success=True,in_scope=True |pct",
    "eval_first_try_pct": "csv docs/eval/2026-10-24-live-eval-run4/eval.rescored.csv condition=ultra/loop_on |share:first_try_feasible=True |pct",
    "eval_loop_gain_pts": "csv docs/eval/2026-10-24-live-eval-run4/eval.rescored.csv condition=ultra/loop_on |gain:success=True;first_try_feasible=True"
  }
