# Nebius Token Factory (OpenAI-compatible). Leave NEBIUS_API_KEY unset to run offline on the
# recorded fixtures (`--llm fixture`). Values below were checked against the Token Factory
# docs and model catalogue on 2026-10-22.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Nemotron 3 Super/Ultra are served from us-central1; used automatically when the global
# endpoint answers 404 for a model. Set empty to disable the fallback.
NEBIUS_REGIONAL_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Model routing (catalogue ids are case-exact). Prices per 1M tokens in/out:
#   nvidia/Nemotron-3_5-Lightning          $0.06 / $0.24   (structure: fast, 1M context)
#   nvidia/Nemotron-3-Ultra-550b-a55b      $1.00 / $3.00   (task graph + repair: reasoning)
#   nvidia/nemotron-3-super-120b-a12b      $0.30 / $0.90   (explanation prose)
#   nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B  $0.06 / $0.24   (cheaper alternative for any role)
MOONWRIGHT_MODEL_STRUCTURE=nvidia/Nemotron-3_5-Lightning
MOONWRIGHT_MODEL_TASKGRAPH=nvidia/Nemotron-3-Ultra-550b-a55b
MOONWRIGHT_MODEL_REPAIR=nvidia/Nemotron-3-Ultra-550b-a55b
MOONWRIGHT_MODEL_EXPLAIN=nvidia/nemotron-3-super-120b-a12b

# Thinking: auto = task graph + repair reason, structure + explain answer directly.
# "off" makes every call direct (fast demos), "on" makes every call reason.
MOONWRIGHT_THINKING=auto
# Token budgets: answer-only calls / reasoning + answer calls (they share max_tokens).
MOONWRIGHT_MAX_TOKENS=4096
MOONWRIGHT_THINKING_MAX_TOKENS=16384
# Per-request timeout in seconds (default 120 for direct calls, 300 for reasoning calls).
MOONWRIGHT_LLM_TIMEOUT_S=

# Client kind: "fixture" (offline canned outputs), "nebius" (live), "record" (live + save
# fixtures). Default: nebius when NEBIUS_API_KEY is set, fixture otherwise.
MOONWRIGHT_LLM=

# CORS for a deployed web UI. Every http://localhost:* / http://127.0.0.1:* origin is allowed
# without configuration. Exact origins (scheme + host [+ port], comma-separated, no path; a
# trailing slash is tolerated) and/or a pattern, e.g. every Vercel preview deployment. A page
# on https:// can only call an https:// backend (mixed content is blocked by browsers).
MOONWRIGHT_CORS_ORIGINS=
MOONWRIGHT_CORS_ORIGIN_REGEX=
# e.g. MOONWRIGHT_CORS_ORIGINS=https://moonwright.vercel.app
#      MOONWRIGHT_CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Call log: one JSON line per live request (timestamp, role, model, endpoint, json level,
# thinking flag, finish_reason, tokens, latency, HTTP status, x-request-id; never the prompt or
# the answer text). Default backend/out/llm_log.jsonl; "off" disables it.
MOONWRIGHT_LLM_LOG=

# Optional: Tavily for the landing-site briefing (F10, bonus award).
TAVILY_API_KEY=
